{
  "name": "ankur-gupta-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "export": "next build && next export",
    "deploy": "npm run build && touch out/.nojekyll && echo 'ankurgupta.net' > out/CNAME",
    "clean": "rm -rf .next out node_modules next-env.d.ts",
    "type-check": "tsc --noEmit",
    "setup": "npm ci",
    "all": "npm run clean && npm run setup && npm run build"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.0.0"
  }
}
